rules_version = '2';

// Ver ARCHITECTURE.md y firestore.rules para el razonamiento completo.
// Análogo a firestore.rules pero para archivos (fotos de animales).
//
// OJO: la regla de escritura usa firestore.get() (cross-service). Para que
// funcione en producción, el agente de servicio de Firebase Rules
// (service-<nº-de-proyecto>@firebase-rules.iam.gserviceaccount.com) necesita
// el rol "roles/firebaserules.firestoreServiceAgent". La CLI lo otorga al
// desplegar, pero solo si puede preguntar (modo interactivo) — un deploy
// desde un script no interactivo se salta ese paso en silencio y entonces
// TODA subida da 403 aunque la regla esté bien escrita. Eso pasó el
// 2026-07-10 y se arregló otorgando el rol vía la API de IAM.

service firebase.storage {
  match /b/{bucket}/o {

    // ── rescates/{rescateId}/fotoN.jpg ──────────────────────────────────
    // Catálogo público — lectura abierta, igual que el documento de
    // Firestore correspondiente. La escritura solo la puede hacer el
    // dueño real del rescate, verificado cruzando contra el documento de
    // Firestore (no alcanza con "cualquier usuario logueado": como la
    // lectura de `rescates` es pública, cualquiera podría enumerar
    // rescateIds reales y sobreescribir/vandalizar la foto de otro
    // rescatista si no se valida dueño de verdad).
    match /rescates/{rescateId}/{fileName} {
      allow read: if true;
      // fileName acotado a los 2 nombres que la app realmente usa
      // (RescateFotosRepository._ref) — sin esto, el dueño verificado
      // podía subir CUALQUIER nombre/contenido bajo su propia carpeta
      // (pública de lectura), no solo foto1.jpg/foto2.jpg. Bajo impacto
      // (sigue acotado a su propia carpeta, no cruza entre usuarios), pero
      // gratis de cerrar.
      //
      // Tope de tamaño y tipo — antes esta regla no limitaba ninguno de
      // los dos. La app SIEMPRE normaliza la foto a JPEG chico antes de
      // subir (foto_normalizador.dart: máx 1000px de ancho, calidad 80 —
      // una foto real termina pesando centenas de KB, nunca cerca de
      // este tope), así que a quien usa la app de verdad esto nunca lo va
      // a frenar. Pero eso es solo una convención del lado del cliente —
      // sin esto en la REGLA, cualquier cuenta autenticada dueña de un
      // rescate propio podía llamar directo a la API de Storage y subir
      // un archivo de cualquier tamaño/tipo bajo foto1.jpg — como la
      // lectura es pública, quedaba abierto como hosting gratis de
      // archivos arbitrarios a costa de la cuenta de Firebase, y una
      // "foto" corrupta/gigante podía colgar por falta de memoria el
      // teléfono de cualquiera que la mirara. Mismo tope (15MB) que ya
      // usa RescateFotosRepository._maxBytesFoto para la descarga.
      // Hallazgo de auditoría de código previa a subir a Play Store.
      allow write: if request.auth != null &&
        fileName in ['foto1.jpg', 'foto2.jpg'] &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*') &&
        firestore.get(/databases/(default)/documents/rescates/$(rescateId)).data.rescatistaId == request.auth.uid;
    }
  }
}
