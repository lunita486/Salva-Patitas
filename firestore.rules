rules_version = '2';

// Ver ARCHITECTURE.md para el razonamiento completo. Resumen: esta es la
// barrera real de seguridad — el filtrado del lado del cliente (en Dart)
// es solo para no traer datos de más, nunca hay que asumir que alcanza.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function myRoles() {
      return signedIn()
        ? get(/databases/$(database)/documents/usuarios/$(uid())).data.get('roles', [])
        : [];
    }

    function hasRole(r) {
      return signedIn() && r in myRoles();
    }

    // Como `rescatistaId` en un chat puede ser un uid distinto al que está
    // escribiendo (ej. el adoptante crea el chat, pero el rol que se valida
    // es el del rescatista/albergue del otro lado), no alcanza con hasRole().
    function tieneRol(elUid, rol) {
      return signedIn() &&
        rol in get(/databases/$(database)/documents/usuarios/$(elUid)).data.get('roles', []);
    }

    // ── usuarios ──────────────────────────────────────────────────────
    // Perfil de cuenta. Hay pantallas públicas (albergue_publico_screen,
    // aliado_publico_screen) que leen el perfil de OTRO usuario, así que
    // la lectura es abierta a cualquiera logueado. La escritura es solo
    // del dueño, y si toca `roles`, se valida contra la lista permitida
    // (antes cualquier cliente podía escribir cualquier string ahí).
    match /usuarios/{userId} {
      // ── P0-2 (auditoría del 2026-08-25) ──────────────────────────────
      // Esto era `allow read: if signedIn()`, y en Firestore `read` cubre
      // `get` (leer UN documento) Y `list` (listar la colección). La regla
      // se escribió pensando solo en el `get` — las pantallas públicas de
      // albergue y de aliado, y el chat, necesitan leer el perfil de la
      // contraparte. Pero con la misma condición cualquier cuenta recién
      // registrada podía pedir la colección ENTERA y bajarse el nombre,
      // email, foto, ciudad, coordenadas, teléfono, dirección y fcmToken
      // de TODOS los usuarios. Verificado contra el emulador.
      //
      // Además de la fuga en sí, era lo que entregaba la lista de uids que
      // el agujero de chats.create necesitaba para elegir blancos.
      allow get: if signedIn();
      // El único listado real de la app es el directorio de negocios
      // aliados (UsuariosRepository.aliados()). Esta condición es la que
      // hace que ESA consulta siga andando y que cualquier otra se
      // rechace: Firestore acepta un `list` solo si puede DEMOSTRAR, a
      // partir de los filtros de la consulta, que todo lo que devolvería
      // cumple la regla.
      //
      // Ojo con esa palabra, "demostrar". La consulta era
      // `where('aliadoNombre', isGreaterThan: '')` y la regla espejo
      // (`resource.data.aliadoNombre > ''`) NO alcanza: el motor solo sabe
      // hacer esa demostración con igualdad y con `array-contains`, no con
      // rangos. Probado contra el emulador, las dos variantes daban
      // permission-denied. Por eso la consulta pasó a filtrar por el ROL,
      // que los aliados ya tienen, y el filtro por nombre quedó del lado
      // de Dart.
      //
      // Residual conocido: un aliado queda listable con su documento
      // entero, no solo con los 2 campos que la pantalla usa. No es una
      // fuga nueva — su nombre, tipo, teléfono, dirección, email y web ya
      // se muestran en su perfil público a cualquiera que esté logueado.
      // Lo que sí sobra ahí es `fcmToken` y `ultimaVezActiva`. Cerrarlo
      // del todo pide mover el directorio a una colección pública aparte
      // con solo los campos de vitrina; queda anotado, no hecho.
      allow list: if signedIn() && 'aliado' in resource.data.roles;
      allow write: if signedIn() && uid() == userId &&
        (!('roles' in request.resource.data) ||
          request.resource.data.roles.hasOnly(['adoptante', 'rescatista', 'albergue', 'aliado']));
    }

    // ── rescates ──────────────────────────────────────────────────────
    // Catálogo de adopción — lectura pública, INCLUYE lat/long exacta.
    // Decisión consciente (no un descuido): que se pueda ver sin cuenta
    // ayuda a que se comparta y a que gente sin la app decida entrar.
    // Escritura solo del dueño, y `creadoPor` tiene que coincidir con un
    // rol de cuenta que ese uid realmente tenga (no puede publicar como
    // 'albergue' si su cuenta nunca activó ese rol).
    match /rescates/{rescateId} {
      allow read: if true;
      allow create: if signedIn() &&
        request.resource.data.rescatistaId == uid() &&
        request.resource.data.creadoPor in ['rescatista', 'albergue'] &&
        hasRole(request.resource.data.creadoPor);
      // update NO deja reescribir rescatistaId ni creadoPor — antes solo se
      // pedía ser el dueño ACTUAL, sin restringir a qué podía cambiarlo.
      // Eso dejaba "regalarle" un animal propio al uid de cualquier otra
      // persona con un simple update(), lo que reabría por otra puerta el
      // mismo ataque de notificación falsa que el anclaje de
      // solicitudes.create de arriba supuestamente había cerrado — ese
      // anclaje compara contra ESTE documento, y quedaba falsificable
      // después de creado. Hallazgo de auditoría de código.
      allow update: if signedIn() && resource.data.rescatistaId == uid() &&
        request.resource.data.rescatistaId == resource.data.rescatistaId &&
        request.resource.data.creadoPor == resource.data.creadoPor;
      allow delete: if signedIn() && resource.data.rescatistaId == uid();
    }

    // ── solicitudes ───────────────────────────────────────────────────
    // Privado: contiene datos de vivienda/familia del adoptante. Solo lo
    // ven el adoptante dueño y el rescatista/albergue destinatario.
    match /solicitudes/{solicitudId} {
      allow read: if signedIn() &&
        (resource.data.adoptanteId == uid() || resource.data.rescatistaId == uid());
      // El estado inicial SIEMPRE es 'pendiente' — nunca se puede crear una
      // solicitud que ya nazca 'aprobada'. Sin esto, la rama de abajo que
      // protege el update no servía de nada: bastaba con saltarse el update
      // y escribir el documento ya aprobado de entrada. Y como
      // SolicitudesRepository.tuvoSolicitudAprobada() consulta solo por
      // rescateId + estado 'aprobada' (sin filtrar por dueño), una sola
      // solicitud falsa contra el rescateId de CUALQUIER albergue —
      // `rescates` es de lectura pública, los ids están a la vista— dejaba
      // ese animal marcado para siempre como "tuvo una adopción aprobada",
      // y RescatesRepository.bloqueoParaEliminar lo trata como bloqueo
      // permanente: el dueño real no podía volver a borrarlo nunca, sin
      // ninguna forma de deshacerlo desde la app. `acuerdoAceptado` va en
      // la misma regla por lo mismo: solo se activa por la rama del
      // adoptante de abajo, con la solicitud ya aprobada de verdad.
      // rescateId tiene que apuntar a un animal que existe DE VERDAD, y
      // rescatistaId tiene que coincidir con el dueño real de ESE animal
      // — mismo anclaje que ya usa chats.create (ver ese comentario). Sin
      // esto, rescatistaId no se validaba contra nada: cualquiera podía
      // escribir el uid de cualquier persona del sistema ahí (rescates es
      // de lectura pública, los ids están a la vista) y disparar
      // onNuevaSolicitud, que manda un push de verdad usando nombre/
      // animalNombre tal cual — campos que no se validan más que "son
      // texto". Confirmado explotable contra el emulador: una cuenta sin
      // ninguna relación con el destinatario podía mandarle una
      // notificación push con texto inventado (probado con un mensaje
      // tipo phishing). Con este anclaje, ya no se puede elegir a
      // cualquiera del sistema como blanco — solo a quien de verdad
      // tiene ESE animal publicado.
      allow create: if signedIn() &&
        request.resource.data.adoptanteId == uid() &&
        request.resource.data.estado == 'pendiente' &&
        !('acuerdoAceptado' in request.resource.data) &&
        !('acuerdoAceptadoEn' in request.resource.data) &&
        request.resource.data.get('rescateId', '') != '' &&
        get(/databases/$(database)/documents/rescates/$(request.resource.data.rescateId)).data.rescatistaId
          == request.resource.data.rescatistaId;
      // Solo el rescatista/albergue dueño del animal puede cambiar el
      // estado (aprobar/rechazar) — el adoptante lee su propia solicitud
      // pero nunca la escribe después de creada. Antes cualquiera de las
      // dos partes podía hacer update() sin que la regla restringiera qué
      // campo cambiaba: un adoptante podía escribir estado:'aprobada' en
      // su propia solicitud (no podía tocar el animal, pero sí falsear el
      // estado y disparar el push de "¡tu solicitud fue aprobada!" sin que
      // nadie del otro lado la hubiera aprobado en realidad).
      //
      // Segunda rama: el adoptante SÍ puede escribir, pero solo
      // `acuerdoAceptado`/`acuerdoAceptadoEn` ("registro del acuerdo de
      // adopción" — ver SolicitudesRepository.aceptarAcuerdo), y solo una
      // vez la solicitud ya está aprobada, y solo poniéndolo en `true`
      // (nunca puede desmarcarlo una vez aceptado).
      //
      allow update: if signedIn() && (
        (resource.data.rescatistaId == uid() &&
         resource.data.estado == 'pendiente' &&
         request.resource.data.estado in ['aprobada', 'rechazada'] &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'motivoRechazo']))
        ||
        (resource.data.adoptanteId == uid() &&
         resource.data.estado == 'aprobada' &&
         request.resource.data.acuerdoAceptado == true &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acuerdoAceptado', 'acuerdoAceptadoEn']))
      );
    }

    // ── preferencias ──────────────────────────────────────────────────
    // Antes: un único documento fijo compartido por todos ("adoptante").
    // Ahora el id del documento es el uid — cada quien ve/edita el suyo.
    // También vive acá `perfilAdopcion` (vivienda, niños, mascotas, horas
    // fuera de casa) — es sensible y antes se guardaba en `usuarios/{uid}`,
    // que es de lectura pública para cualquier usuario logueado.
    match /preferencias/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // ── favoritos ─────────────────────────────────────────────────────
    // `rescatistaId` también puede leer/borrar (no solo `adoptanteId`):
    // al borrar un rescate, RescatesRepository.eliminar() limpia los
    // favoritos que le apuntan para que no queden huérfanos mostrando un
    // animal que ya no existe como si siguiera disponible — eso corre con
    // la sesión del rescatista/albergue, no la del adoptante dueño del
    // favorito. La query que hace esa limpieza filtra por rescatistaId
    // (no trae favoritos ajenos), así que ampliar acá no expone nada que
    // ese dueño no pueda ya inferir de sus propios rescates.
    match /favoritos/{favId} {
      // Solo el adoptante dueño lee/borra sus favoritos. La limpieza de
      // favoritos huérfanos cuando un rescatista borra su animal NO
      // necesita este permiso: la corre el Cloud Function
      // onRescateEliminado (functions/index.js) con privilegios de
      // administrador, que ignora estas reglas — garantizado, sin
      // depender de que el rescatista tenga señal en ese momento. Ampliar
      // esto a `rescatistaId == uid()` (como estuvo antes) le daba a
      // cualquier rescatista/albergue permiso para leer y borrar los
      // favoritos de CUALQUIER adoptante sobre sus animales, en cualquier
      // momento — no solo durante una limpieza real (hallazgo de
      // auditoría de código).
      allow read, delete: if signedIn() && resource.data.adoptanteId == uid();
      allow create: if signedIn() && request.resource.data.adoptanteId == uid();
      allow update: if signedIn() && resource.data.adoptanteId == uid() &&
        request.resource.data.adoptanteId == uid();
    }

    // ── chats ─────────────────────────────────────────────────────────
    // Un chat identifica a sus dos dueños (adoptanteId/rescatistaId). Los
    // chats sobre un animal además llevan `creadoPor` (rescatista/albergue)
    // para separar bandejas en cuentas con doble rol. Y, como en
    // `solicitudes`, los campos de identidad no se pueden reescribir después.
    //
    // La validación de `creadoPor` está anclada al documento REAL de
    // `rescates` (rescatistaId + creadoPor deben coincidir con ese animal),
    // no al rol ACTUAL de la cuenta — antes usaba tieneRol() para revisar
    // los roles de hoy de rescatistaId, y una cuenta que alguna vez publicó
    // como 'albergue' pero después cambió sus roles (ej. dejó de ser
    // albergue) quedaba con todos sus animales viejos huérfanos: ningún
    // adoptante podía volver a abrirles un chat nuevo, aunque el animal
    // siguiera publicado y visible en el feed. Esto pasó de verdad: un
    // rescate quedó con creadoPor:'albergue' apuntando a una cuenta cuyos
    // roles ya no incluían 'albergue', y "Hacer una pregunta" tiraba
    // permission-denied en silencio.
    //
    // Una consulta a un ALIADO (tipoSolicitud 'consulta_aliado') también usa
    // `creadoPor` para separar la bandeja de rescatista y de albergue — pero
    // ahí rescatistaId es siempre el aliado (nunca tiene rol
    // rescatista/albergue), y quien realmente tiene ese rol es adoptanteId
    // (quien contactó). No hay rescate contra el cual anclar, así que se
    // valida con tieneRol() sobre adoptanteId en vez de rescatistaId.
    match /chats/{chatId} {
      allow read: if signedIn() &&
        (resource.data.adoptanteId == uid() || resource.data.rescatistaId == uid());
      //
      // ── P0-1 (auditoría del 2026-08-25) ──────────────────────────────
      // Esta regla decía, en resumen: "si `creadoPor` no viene, pasá".
      // Ese `!('creadoPor' in request.resource.data) ||` se había puesto
      // para tolerar los chats legados que no tienen el campo, pero
      // tolerar el dato viejo es lo mismo que dejar omitirlo a propósito:
      // bastaba con NO mandar el campo para saltearse el anclaje entero.
      // Cualquier cuenta podía crear un chat contra CUALQUIER otro uid
      // (los uids se cosechan listando `usuarios`, ver P0-2) y meterle un
      // mensaje. onNuevoMensaje entonces le manda una push de verdad con
      // el título sacado de `animalNombre` y el cuerpo del `texto` — los
      // dos elegidos por quien ataca. Phishing con la credibilidad de la
      // app. Verificado explotable contra el emulador.
      //
      // La forma correcta no es "exigir creadoPor" a secas: hay un caso
      // legítimo que NO lo lleva (un adoptante que le escribe a un negocio
      // aliado — ver asegurarChatNegocio, que solo escribe el campo cuando
      // el contexto es rescatista/albergue). Exigirlo sin más rompía el
      // botón "Contactar" de la pantalla de aliados.
      //
      // Así que ahora se enumeran las TRES formas legítimas, cada una con
      // su propio anclaje, y todo lo que no encaje en una de ellas se
      // rechaza. Ya no hay una rama que se saltee el anclaje.
      allow create: if signedIn() &&
        (request.resource.data.adoptanteId == uid() || request.resource.data.rescatistaId == uid()) &&
        (
          // (A) Chat sobre un animal. Anclado al documento REAL del
          // rescate: quien figura como rescatista tiene que ser su dueño
          // de verdad, y con el mismo sombrero con el que lo publicó.
          (request.resource.data.get('rescateId', '') != '' &&
           request.resource.data.get('creadoPor', '') in ['rescatista', 'albergue'] &&
           get(/databases/$(database)/documents/rescates/$(request.resource.data.rescateId)).data.rescatistaId == request.resource.data.rescatistaId &&
           get(/databases/$(database)/documents/rescates/$(request.resource.data.rescateId)).data.creadoPor == request.resource.data.creadoPor)
          ||
          // (B) Consulta a un negocio aliado. Acá `rescatistaId` es el
          // aliado y `adoptanteId` es quien pregunta, sin importar qué rol
          // tenga en la vida real (es la convención del esquema).
          //
          // El anclaje es que el DESTINATARIO sea de verdad un negocio
          // registrado. Antes se miraba el rol de `adoptanteId` (el que
          // pregunta), que es justamente el lado que controla quien ataca:
          // con el rol de rescatista puesto a mano (son auto-asignables) se
          // podía elegir a cualquiera como `rescatistaId` y mandarle la
          // push igual. Mirar el lado del destinatario es lo que cierra
          // eso: solo se le puede escribir a quien publicó un negocio.
          //
          // Además `adoptanteId == uid()`: la consulta la abre quien
          // pregunta, nunca un tercero. Cubre también el caso real de una
          // cuenta que se consulta a sí misma (adoptanteId == rescatistaId
          // == su propio uid), probado en teléfono el 2026-08-03.
          (request.resource.data.get('tipoSolicitud', '') == 'consulta_aliado' &&
           request.resource.data.adoptanteId == uid() &&
           tieneRol(request.resource.data.rescatistaId, 'aliado') &&
           (!('creadoPor' in request.resource.data) ||
            request.resource.data.creadoPor in ['rescatista', 'albergue']))
          ||
          // (C) Anclado a una SOLICITUD real. Es el gemelo de (A) para el
          // caso en que no hay animal contra el cual anclar: una solicitud
          // vieja, de antes de que la regla de solicitudes.create volviera
          // `rescateId` obligatorio.
          //
          // Un chat entre un rescatista y un adoptante es legítimo si los
          // une un animal real O una solicitud real. Esta rama es la
          // segunda mitad de esa frase, y es la que deja que el aviso
          // automático de "tu solicitud fue rechazada" o "este animalito
          // falleció" siga pudiendo CREAR el chat cuando el adoptante
          // nunca lo abrió. Sin ella, ese aviso no llegaba nunca — que es
          // el bug que avisarSobreAnimal ya había arreglado una vez.
          //
          // La solicitud tiene que unir exactamente a estas dos personas:
          // no alcanza con que exista.
          (request.resource.data.get('solicitudId', '') != '' &&
           get(/databases/$(database)/documents/solicitudes/$(request.resource.data.solicitudId)).data.adoptanteId == request.resource.data.adoptanteId &&
           get(/databases/$(database)/documents/solicitudes/$(request.resource.data.solicitudId)).data.rescatistaId == request.resource.data.rescatistaId)
          ||
          // (D) La ÚLTIMA rama sin ancla. Sigue abierta, a sabiendas.
          //
          // El único camino de la app que llegaba acá era una fuga de dato,
          // no un caso legítimo: al abrir la ficha del animal DESDE un chat,
          // chat_screen armaba el mapa con `...d` (los campos del rescate),
          // y `rescateId` es el NOMBRE del documento, no un campo adentro,
          // así que se perdía. Volver al chat desde esa ficha caía al
          // esquema viejo de id por nombre y abría una conversación
          // DUPLICADA, sin nada contra lo cual anclarla. Arreglado en
          // APK91 (chat_screen.dart, `'rescateId': rescateId`).
          //
          // Pero NO alcanza con esperar a que todos actualicen: queda un
          // segundo camino vivo, con el APK nuevo y todo. Una solicitud
          // vieja (anterior a que `rescateId` fuera obligatorio) hace que
          // mis_solicitudes_screen arme el chat con rescateId '' (ver la
          // línea `d['rescateId'] as String? ?? ''` ahí), y el adoptante
          // cae de nuevo acá al tocar "Ir al chat".
          //
          // Mientras esta rama exista sigue siendo posible abrirle un chat
          // a una cuenta con rol de rescatista/albergue con un
          // `animalNombre` inventado, que es el título de la push. El
          // alcance es mucho menor que el agujero original (antes era
          // cualquier cuenta contra cualquier cuenta, ahora solo contra
          // rescatistas/albergues, y es lo que un adoptante ya puede hacer
          // legítimamente por la rama (A)) pero no es cero.
          //
          // Para cerrarla de verdad hay que pasarle el `solicitudId` a
          // ChatScreen en ese camino, y entonces cae en (C) como el aviso
          // automático. Recién ahí se puede borrar este bloque junto con
          // su test positivo "(D) el camino viejo sigue abierto...",
          // dejando el negativo.
          (request.resource.data.get('rescateId', '') == '' &&
           request.resource.data.get('solicitudId', '') == '' &&
           request.resource.data.get('tipoSolicitud', '') != 'consulta_aliado' &&
           request.resource.data.adoptanteId == uid() &&
           request.resource.data.get('creadoPor', '') in ['rescatista', 'albergue'] &&
           tieneRol(request.resource.data.rescatistaId, request.resource.data.creadoPor))
        );
      allow update: if signedIn() &&
        request.resource.data.adoptanteId == resource.data.adoptanteId &&
        request.resource.data.rescatistaId == resource.data.rescatistaId &&
        request.resource.data.get('creadoPor', null) == resource.data.get('creadoPor', null) &&
        (resource.data.adoptanteId == uid() || resource.data.rescatistaId == uid());

      match /mensajes/{mensajeId} {
        allow read: if signedIn() &&
          (get(/databases/$(database)/documents/chats/$(chatId)).data.adoptanteId == uid() ||
           get(/databases/$(database)/documents/chats/$(chatId)).data.rescatistaId == uid());
        // emisor tiene que coincidir con el lado REAL de quien escribe —
        // antes cualquiera de los dos participantes podía mandar su propio
        // mensaje marcado con el emisor DEL OTRO. chat_screen.dart calcula
        // de qué lado se pinta la burbuja comparando el rol propio contra
        // este campo, así que ese mensaje falsificado se veía, en la
        // pantalla de la VÍCTIMA, como si ELLA lo hubiera escrito — y
        // onNuevoMensaje (functions/index.js) decide a quién mandarle la
        // notificación mirando este mismo campo, así que también le podía
        // robar el aviso a la persona real. Hallazgo de auditoría de código.
        // texto tiene un tope de largo — antes ni la app ni la regla
        // ponían ningún límite, así que alguien podía mandar texto
        // gigante saltándose el límite del campo (que solo frena a quien
        // usa la app de verdad, no a quien escribe directo contra
        // Firestore). Mismo tope que el campo de la app (2000). Hallazgo
        // de auditoría de código.
        //
        // El ternario chequea adoptanteId PRIMERO, no rescatistaId — en un
        // chat de consulta a un negocio (`consulta_aliado`), una cuenta que
        // publicó ese mismo negocio aliado tiene adoptanteId == rescatistaId
        // == su propio uid al consultarse a sí misma (probado en teléfono
        // real, 2026-08-03: "No se pudo enviar el mensaje" al escribirle a
        // un negocio registrado con la misma cuenta que preguntaba).
        // chat_screen.dart SIEMPRE manda emisor 'adoptante' para quien inició
        // la consulta (es la convención del esquema: adoptanteId es
        // "quien preguntó", sin importar qué rol tenga en la vida real) —
        // con rescatistaId comprobado primero, ese caso exigía 'rescatista'
        // en cambio, y la escritura se rechazaba siempre. Priorizar
        // adoptanteId resuelve la ambigüedad a favor de lo que el cliente
        // realmente manda.
        allow create: if signedIn() &&
          (get(/databases/$(database)/documents/chats/$(chatId)).data.adoptanteId == uid() ||
           get(/databases/$(database)/documents/chats/$(chatId)).data.rescatistaId == uid()) &&
          request.resource.data.emisor == (
            get(/databases/$(database)/documents/chats/$(chatId)).data.adoptanteId == uid()
              ? 'adoptante' : 'rescatista'
          ) &&
          request.resource.data.texto is string &&
          request.resource.data.texto.size() <= 2000;
      }
    }

    // ── servicios ─────────────────────────────────────────────────────
    // Catálogo de negocios aliados — lectura pública, escritura solo del
    // aliado dueño.
    match /servicios/{servicioId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.aliadoId == uid() && hasRole('aliado');
      // update NO deja reescribir aliadoId — mismo agujero que se cerró en
      // rescates.update: sin este candado, el propio dueño podía
      // "regalarle" su servicio al uid de cualquier otra persona
      // (servicios es de lectura pública, así que quedaba publicado a
      // nombre de otro negocio sin su consentimiento). Hallazgo de
      // auditoría de código.
      allow update: if signedIn() && resource.data.aliadoId == uid() &&
        request.resource.data.aliadoId == resource.data.aliadoId;
      allow delete: if signedIn() && resource.data.aliadoId == uid();
    }

    // ── hogaresDePaso ─────────────────────────────────────────────────
    // Roster de personas de confianza para hogar de paso — privado, solo
    // lo ve/edita el albergue dueño (`albergueId`). Solo para albergues,
    // no rescatistas (decisión de producto: mejoras_albergue.html).
    match /hogaresDePaso/{docId} {
      allow read, delete: if signedIn() && resource.data.albergueId == uid();
      // update NO deja reescribir albergueId — mismo motivo que en
      // servicios.update: sin este candado se podía inyectar un contacto
      // falso directo en el roster PRIVADO de otro albergue, reescribiendo
      // a quién pertenece una fila propia. Hallazgo de auditoría de código.
      allow update: if signedIn() && resource.data.albergueId == uid() &&
        request.resource.data.albergueId == resource.data.albergueId;
      // hasRole('albergue') es lo que hace cumplir "solo para albergues,
      // no rescatistas" en la práctica — antes solo se pedía que
      // albergueId fuera uno mismo, así que una cuenta rescatista (sin
      // ese rol) también podía crear acá, aunque el dato quedara
      // igual acotado a su propio uid (nunca se filtraba entre cuentas).
      allow create: if signedIn() &&
        request.resource.data.albergueId == uid() &&
        hasRole('albergue');
    }

    // ── solicitudes_rescatista ────────────────────────────────────────
    // Pantalla "volverme rescatista verificado" — no está enlazada desde
    // ninguna navegación hoy (código huérfano). Se bloquea por completo
    // a propósito hasta que alguien la conecte y le agregue su propia regla.
    match /solicitudes_rescatista/{docId} {
      allow read, write: if false;
    }
  }
}
