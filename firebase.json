{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "predeploy": ["npm --prefix test_rules test"]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    // 8080, no 8097 — cambiado a propósito: en esta máquina, con el
    // emulador de Android corriendo (algo de su propia red interna,
    // netsimd probablemente), el puerto 8080 ya está ocupado, y el
    // emulador de Firestore no podía arrancar ("Port taken") ni para
    // correr los tests ni para desplegar. 8097 es libre. Si esto se
    // corre en otra máquina sin el emulador de Android abierto, 8080
    // también hubiera andado — no es un problema del proyecto, es un
    // choque puntual con lo que ya estaba corriendo acá.
    "firestore": { "port": 8097 },
    // Auth y Storage existen solo para el modo sandbox de la app (ver
    // lib/data/sandbox.dart). Los tests de reglas no los usan.
    //
    // El de Auth es lo que hace posible entrar a la app sin una cuenta de
    // Google real: contra el emulador, email+contraseña alcanza, y no hay
    // ninguna credencial de verdad de por medio.
    "auth": { "port": 9099 },
    "storage": { "port": 9199 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
